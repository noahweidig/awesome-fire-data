{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset entry",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "icon", "summary", "provider", "coverage", "period", "resolution", "format", "license", "update", "access", "docs", "tags"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "title": {"type": "string", "minLength": 2},
      "icon": {"type": "string", "pattern": "^lucide/[a-z0-9-]+$"},
      "summary": {"type": "string", "minLength": 10, "maxLength": 300},
      "provider": {"type": "string", "minLength": 2},
      "coverage": {"type": "string", "minLength": 2},
      "period": {"type": "string", "minLength": 2},
      "resolution": {"type": "string", "minLength": 1},
      "format": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "license": {"type": "string", "minLength": 2},
      "update": {"type": "string", "minLength": 2},
      "access": {"type": "string", "pattern": "^https?://"},
      "docs": {"type": "string", "pattern": "^https?://"},
      "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "caveat": {"type": "string"},
      "doi": {"type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$"},
      "citation": {"type": "string", "minLength": 10},
      "verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "snippets": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "lang", "code"],
          "properties": {"label": {"type": "string"}, "lang": {"type": "string"}, "code": {"type": "string"}}
        }
      },
      "related": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
    }
  }
}
